# Скопировать в .env.local для локального запуска
# или в .env.docker для Docker Compose.
# Заменить заглушки SECRET_KEY и POSTGRES_PASSWORD своими значениями.
SECRET_KEY=replace-with-your-own-secret-key
DEBUG=True

# В .env.local и .env.docker использовать одинаковые параметры одной БД.
POSTGRES_DB=whyandwhat
POSTGRES_USER=whyandwhat
POSTGRES_PASSWORD=replace-with-your-own-database-password

# Локальный запуск Django: 127.0.0.1.
# Docker Compose: заменить на db (имя сервиса PostgreSQL).
DB_HOST=127.0.0.1
DB_PORT=5432
