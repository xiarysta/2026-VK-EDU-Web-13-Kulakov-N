# Основной запуск: скопировать в .env.docker для Docker Compose.
# Для запуска Django без Docker: скопировать в .env.local и изменить DB_HOST.
# Заменить заглушки SECRET_KEY и POSTGRES_PASSWORD своими значениями.
SECRET_KEY=replace-with-your-own-secret-key
DEBUG=True

# В .env.local и .env.docker использовать одинаковые параметры одной БД.
POSTGRES_DB=whyandwhat
POSTGRES_USER=whyandwhat
POSTGRES_PASSWORD=replace-with-your-own-database-password

# Docker Compose: db (имя сервиса PostgreSQL).
# Для Django, запущенного вне Docker: заменить на 127.0.0.1.
DB_HOST=db
DB_PORT=5432

# nginx не требует переменных окружения.
# Адрес сайта и пути к файлам: docker-compose.yaml и nginx/default.conf.
